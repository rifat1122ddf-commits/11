{
  "name": "dragon-ai-assistant",
  "version": "2.0.0",
  "description": "Dragon AI Assistant - Professional Desktop Automation Companion",
  "main": "main.js",
  "homepage": "./",
  "private": true,
  "scripts": {
    "dev": "electron .",
    "start": "cross-env NODE_ENV=production electron .",
    "build": "npm run build:win",
    "build:win": "electron-builder --win --publish never",
    "dist": "electron-builder",
    "pack": "electron-builder --dir",
    "prestart": "npm run check-deps",
    "check-deps": "node scripts/check-deps.js"
  },
  "author": "rifat1122ddf-commits",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3",
    "cross-env": "^7.0.3"
  },
  "dependencies": {
    "node-fetch": "^2.7.0",
    "robotjs": "^0.6.0",
    "electron-squirrel-startup": "^1.1.0"
  },
  "build": {
    "appId": "com.rifat.dragonassistant",
    "productName": "Dragon AI Assistant",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "*.js",
      "preload.js",
      "node_modules/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64", "ia32"]
        },
        {
          "target": "portable",
          "arch": ["x64", "ia32"]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Dragon AI Assistant"
    }
  }
}
